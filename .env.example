# ===========================================
# Salma AI Gateway - Environment Configuration
# ===========================================

# Application
ENVIRONMENT=production
DEBUG=false
VERSION=1.0.0
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_KEY

# Database
DB_USER=salma_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=salma_db
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=https://salma.example.com,https://localhost

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# ===========================================
# AI Provider API Keys
# ===========================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI
OPENAI_API_KEY=sk-xxxxx

# Cohere (for Arabic embeddings)
COHERE_API_KEY=

# Jais (G42) - Optional
JAIS_API_KEY=

# ===========================================
# Feature Flags
# ===========================================

ENABLE_DOCUMENT_PROCESSING=true
ENABLE_VECTOR_SEARCH=true
ENABLE_AUDIT_LOGGING=true
ENABLE_METRICS=true

# ===========================================
# Monitoring
# ===========================================

GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# ===========================================
# Security
# ===========================================

# JWT Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# On-Premise Settings (KSA)
# ===========================================

# Data residency
DATA_RESIDENCY=SA

# Encryption at rest
ENCRYPT_UPLOADS=true
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY

# Audit retention (days)
AUDIT_RETENTION_DAYS=365
